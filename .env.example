# Copy to .env and fill in.

PORT=3000

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare?schema=public"
# Set to 1 when DATABASE_URL points at `npx prisma dev` (it serves one connection at a time).
# Leave unset for a real Postgres server.
# DATABASE_POOL_MAX=1

# At least 32 bytes. Generate: openssl rand -base64 32
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Browser origins allowed to call the API (admin/pharmacy portal). Mobile apps need no entry.
CORS_ORIGINS=http://localhost:3001

# Private folder for prescription uploads (never served statically)
UPLOAD_DIR=uploads

# Platform local time, minutes east of UTC (Pakistan = 300). Used for doctor slots.
TZ_OFFSET_MINUTES=300

# Shared secret your payment gateway uses to sign webhooks (HMAC-SHA256, header x-signature)
PAYMENT_WEBHOOK_SECRET=

# First admin account, created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# NestJS Observe (written by `npx @nestjs/observe link`)
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# Development only: create approved demo users for every role
SEED_DEMO_USERS=false
# SEED_DEMO_PASSWORD=Demo@12345
